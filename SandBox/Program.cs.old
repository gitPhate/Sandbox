        static void Main(string[] args)
        {
            MainAsync().GetAwaiter().GetResult();
        }

        static Guid Id;

        static async Task MainAsync()
        {

            var req = new GetTrackingReq
            {
                Lol = "12345"
            };

            FlurlHttp.Configure(settings =>
            {
                settings.BeforeCall = HandleFlurlBeforeCall;
                settings.AfterCallAsync = HandleFlurlAfterCallAsync;
                settings.OnError = HandleFlurlOnError;
            });

            var resp = await ExecuteAPICall<GetTrackingReq, TrackingResp>(req);
        }

        private static void HandleFlurlBeforeCall(FlurlCall call)
        {
            string id = GetXRequestIDHeaderValue(call);
            id = id.IsNullOrBlankString() ? null : $"[{id}] - ";
            _staticLogger.Debug($"{id}{call.RequestBody}");
        }

        private static async Task HandleFlurlAfterCallAsync(FlurlCall call)
        {
            string id = GetXRequestIDHeaderValue(call);
            id = id.IsNullOrBlankString() ? null : $"[{id}] - ";
            string content = await call.HttpResponseMessage.Content.ReadAsStringAsync().ConfigureAwait(false);
            _staticLogger.Debug($"{id}{content}");
        }

        private static void HandleFlurlOnError(FlurlCall call)
        {
            string id = GetXRequestIDHeaderValue(call);
            id = id.IsNullOrBlankString() ? null : $"[{id}] - ";
            _staticLogger.Error(call.Exception, id);
        }

        private static string GetXRequestIDHeaderValue(FlurlCall call)
        {
            if (call.HttpRequestMessage.Headers.TryGetValues("X-Request-ID", out IEnumerable<string> values))
            {
                string callId = values.FirstOrDefault();
                return callId;
            }

            return null;
        }

        static async Task<Result<TResp, ErrorResp>> ExecuteAPICall<TReq, TResp>(TReq req)
        {
            string apiToken = "d466450a1e1f7d40e191933fc8582b18";
            string url = "https://rfidshowroom.gucci.com/SerialInterfaces_SRGucci/api/v1/";

            FinalReq finalReq =
                new FinalReq
                {
                    Method = FinalReq.GetMethod(req),
                    Params = req
                };

            var jsonResponse =
                await
                    url
                        .WithBasicAuth(apiToken, null)
                        .WithHeader("X-Request-ID", Guid.NewGuid())
                        .PostJsonAsync(finalReq)
                        .ReceiveString();

            if (jsonResponse.Contains("Error"))
            {
                ErrorResp errorResp = JsonConvert.DeserializeObject<ErrorResp>(jsonResponse);
                return Result.ErrorE<TResp, ErrorResp>(errorResp, null);
            }

            TResp successResp = JsonConvert.DeserializeObject<TResp>(jsonResponse);
            return Result.SuccessE<TResp, ErrorResp>(successResp);
        }

