    class FinalReq
    {
        public string Method { get; set; }
        public object Params { get; set; } = new object();

        public static string GetMethod<T>(T req)
        {
            var method =
                req
                    .GetType()
                    .GetAttributeOfType<ApiMethodAttribute>()
                    ?.Method;

            if (method.IsNullOrBlankString())
            {
                //error;
            }

            return method;
        }
    }

    class ErrorResp
    {
        public string Error { get; set; }
        public string ValidationErrors { get; set; }
    }

    class TrackingResp
    {
        public string stocazzo { get; set; }
        public string marino { get; set; }
    }

    [ApiMethod("GetTracking")]
    class GetTrackingReq
    {
        [JsonProperty("Code")]
        public string Lol { get; set; }
    }

    [ApiMethod("GetCarriers")]
    class GetCarriersReq { }

    class GetCarriersResp
    {
        public Carrier Carriers { get; set; }
    }

    class Carrier
    {
        public Carrier2 Generic { get; set; }
    }

    class Carrier2
    {
        public string CarrierID { get; set; }
        public string CarrierService { get; set; }
        public string Label { get; set; }
        public string CarrierLogo { get; set; }
    }

    class ApiMethodAttribute : Attribute
    {
        public string Method { get; set; }

        public ApiMethodAttribute(string method)
        {
            Method = method;
        }
    }
